    </bpmn:task>
    <bpmn:sendTask id="P_SendConfirm" name="Підтвердити повернення">
      <bpmn:incoming>P_SF2</bpmn:incoming>
      <bpmn:outgoing>P_SF3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P_End" name="Повернення оброблено провайдером">
      <bpmn:incoming>P_SF3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P_SF1" sourceRef="P_Start" targetRef="P_Process" />
    <bpmn:sequenceFlow id="P_SF2" sourceRef="P_Process" targetRef="P_SendConfirm" />
    <bpmn:sequenceFlow id="P_SF3" sourceRef="P_SendConfirm" targetRef="P_End" />
  </bpmn:process>
