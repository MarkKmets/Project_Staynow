<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Model4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_Model4">
    <bpmn:participant id="Participant_Guest4" name="Гість" processRef="Process_Guest4"/>
    <bpmn:participant id="Participant_Hotel4" name="Готель" processRef="Process_Hotel4"/>
    <bpmn:messageFlow id="MF1" name="Звернення" sourceRef="G_SendAppeal" targetRef="H_Start"/>
    <bpmn:messageFlow id="MF2" name="Відповідь" sourceRef="H_ReplyOther" targetRef="G_CatchAnswer"/>
    <bpmn:messageFlow id="MF3" name="Відповідь" sourceRef="H_ReplyPricing" targetRef="G_CatchAnswer"/>
    <bpmn:textAnnotation id="TextAnnotation_Reminder"><bpmn:text>Межова подія-таймер на задачах відповіді — нагадування виконавцю, а не гостю; звернення лишається в черзі, доки не отримає відповідь</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Reminder" sourceRef="H_ReminderPricing" targetRef="TextAnnotation_Reminder"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Guest4" isExecutable="false">
    <bpmn:startEvent id="G_Start" name="Гість заповнив контактну форму"><bpmn:outgoing>G_SF1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sendTask id="G_SendAppeal" name="Надіслати звернення"><bpmn:incoming>G_SF1</bpmn:incoming><bpmn:outgoing>G_SF2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="G_CatchAnswer" name="Отримано відповідь"><bpmn:incoming>G_SF2</bpmn:incoming><bpmn:outgoing>G_SF3</bpmn:outgoing><bpmn:messageEventDefinition id="G_CatchAnswer_med"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="G_End" name="Відповідь отримана"><bpmn:incoming>G_SF3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="G_SF1" sourceRef="G_Start" targetRef="G_SendAppeal"/>
    <bpmn:sequenceFlow id="G_SF2" sourceRef="G_SendAppeal" targetRef="G_CatchAnswer"/>
    <bpmn:sequenceFlow id="G_SF3" sourceRef="G_CatchAnswer" targetRef="G_End"/>
  </bpmn:process>
  <bpmn:process id="Process_Hotel4" isExecutable="false">
    <bpmn:laneSet id="LaneSet_H4">
      <bpmn:lane id="Lane_System4" name="Система"><bpmn:flowNodeRef>H_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>H_SaveAppeal</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Admin4" name="Адміністратор"><bpmn:flowNodeRef>H_ReadAppeal</bpmn:flowNodeRef><bpmn:flowNodeRef>H_GatewayType</bpmn:flowNodeRef><bpmn:flowNodeRef>H_ReplyOther</bpmn:flowNodeRef><bpmn:flowNodeRef>H_ReminderOther</bpmn:flowNodeRef><bpmn:flowNodeRef>H_EndReminderOther</bpmn:flowNodeRef><bpmn:flowNodeRef>H_GatewayMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>H_GatewayKeep</bpmn:flowNodeRef><bpmn:flowNodeRef>H_MarkProcessed</bpmn:flowNodeRef><bpmn:flowNodeRef>H_DeleteAppeal</bpmn:flowNodeRef><bpmn:flowNodeRef>H_GatewayEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>H_End</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Manager4" name="Менеджер"><bpmn:flowNodeRef>H_ReplyPricing</bpmn:flowNodeRef><bpmn:flowNodeRef>H_ReminderPricing</bpmn:flowNodeRef><bpmn:flowNodeRef>H_EndReminderPricing</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="H_Start" name="Отримано звернення"><bpmn:outgoing>H_SF1</bpmn:outgoing><bpmn:messageEventDefinition id="H_Start_med"/></bpmn:startEvent>
    <bpmn:task id="H_SaveAppeal" name="Зберегти звернення"><bpmn:incoming>H_SF1</bpmn:incoming><bpmn:outgoing>H_SF2</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_Save"><bpmn:targetRef>DataStoreReference_Appeals</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="H_ReadAppeal" name="Прочитати звернення у панелі"><bpmn:incoming>H_SF2</bpmn:incoming><bpmn:outgoing>H_SF3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="H_GatewayType" name="Тип питання?"><bpmn:incoming>H_SF3</bpmn:incoming><bpmn:outgoing>H_SF4</bpmn:outgoing><bpmn:outgoing>H_SF5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="H_ReplyOther" name="Відповісти на звернення на email"><bpmn:incoming>H_SF4</bpmn:incoming><bpmn:outgoing>H_SF6</bpmn:outgoing></bpmn:sendTask>
    <bpmn:boundaryEvent id="H_ReminderOther" name="Минуло 24 год без відповіді" cancelActivity="false" attachedToRef="H_ReplyOther"><bpmn:outgoing>H_SF_rem1</bpmn:outgoing><bpmn:timerEventDefinition id="H_ReminderOther_ted"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="H_EndReminderOther" name="Нагадування виконавцю надіслано"><bpmn:incoming>H_SF_rem1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="H_ReplyPricing" name="Відповісти на email щодо ціни або повернення"><bpmn:incoming>H_SF5</bpmn:incoming><bpmn:outgoing>H_SF7</bpmn:outgoing></bpmn:sendTask>
    <bpmn:boundaryEvent id="H_ReminderPricing" name="Минуло 24 год без відповіді" cancelActivity="false" attachedToRef="H_ReplyPricing"><bpmn:outgoing>H_SF_rem2</bpmn:outgoing><bpmn:timerEventDefinition id="H_ReminderPricing_ted"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="H_EndReminderPricing" name="Нагадування виконавцю надіслано"><bpmn:incoming>H_SF_rem2</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="H_GatewayMerge"><bpmn:incoming>H_SF6</bpmn:incoming><bpmn:incoming>H_SF7</bpmn:incoming><bpmn:outgoing>H_SF8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="H_GatewayKeep" name="Залишити звернення в журналі?"><bpmn:incoming>H_SF8</bpmn:incoming><bpmn:outgoing>H_SF9</bpmn:outgoing><bpmn:outgoing>H_SF10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="H_MarkProcessed" name="Позначити звернення обробленим"><bpmn:incoming>H_SF9</bpmn:incoming><bpmn:outgoing>H_SF11</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_Mark"><bpmn:targetRef>DataObjectReference_Appeal</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="H_DeleteAppeal" name="Видалити звернення"><bpmn:incoming>H_SF10</bpmn:incoming><bpmn:outgoing>H_SF12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="H_GatewayEnd"><bpmn:incoming>H_SF11</bpmn:incoming><bpmn:incoming>H_SF12</bpmn:incoming><bpmn:outgoing>H_SF13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="H_End" name="Звернення оброблено"><bpmn:incoming>H_SF13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="H_SF1" sourceRef="H_Start" targetRef="H_SaveAppeal"/>
    <bpmn:sequenceFlow id="H_SF2" sourceRef="H_SaveAppeal" targetRef="H_ReadAppeal"/>
    <bpmn:sequenceFlow id="H_SF3" sourceRef="H_ReadAppeal" targetRef="H_GatewayType"/>
    <bpmn:sequenceFlow id="H_SF4" name="інше" sourceRef="H_GatewayType" targetRef="H_ReplyOther"/>
    <bpmn:sequenceFlow id="H_SF5" name="про ціни / повернення" sourceRef="H_GatewayType" targetRef="H_ReplyPricing"/>
    <bpmn:sequenceFlow id="H_SF6" sourceRef="H_ReplyOther" targetRef="H_GatewayMerge"/>
    <bpmn:sequenceFlow id="H_SF7" sourceRef="H_ReplyPricing" targetRef="H_GatewayMerge"/>
    <bpmn:sequenceFlow id="H_SF8" sourceRef="H_GatewayMerge" targetRef="H_GatewayKeep"/>
    <bpmn:sequenceFlow id="H_SF9" name="так" sourceRef="H_GatewayKeep" targetRef="H_MarkProcessed"/>
    <bpmn:sequenceFlow id="H_SF10" name="ні" sourceRef="H_GatewayKeep" targetRef="H_DeleteAppeal"/>
    <bpmn:sequenceFlow id="H_SF11" sourceRef="H_MarkProcessed" targetRef="H_GatewayEnd"/>
    <bpmn:sequenceFlow id="H_SF12" sourceRef="H_DeleteAppeal" targetRef="H_GatewayEnd"/>
    <bpmn:sequenceFlow id="H_SF13" sourceRef="H_GatewayEnd" targetRef="H_End"/>
    <bpmn:sequenceFlow id="H_SF_rem1" sourceRef="H_ReminderOther" targetRef="H_EndReminderOther"/>
    <bpmn:sequenceFlow id="H_SF_rem2" sourceRef="H_ReminderPricing" targetRef="H_EndReminderPricing"/>
    <bpmn:dataStoreReference id="DataStoreReference_Appeals" name="Журнал звернень"/>
    <bpmn:dataObjectReference id="DataObjectReference_Appeal" name="Звернення" dataObjectRef="DataObject_Appeal"/>
    <bpmn:dataObject id="DataObject_Appeal"/>
  </bpmn:process>
