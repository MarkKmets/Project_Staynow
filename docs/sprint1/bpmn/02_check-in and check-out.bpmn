<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Model2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_Model2">
    <bpmn:participant id="Participant_Hotel2" name="Готель" processRef="Process_Hotel2" />
    <bpmn:participant id="Participant_Cleaning" name="Служба прибирання" processRef="Process_Cleaning2" />
    <bpmn:messageFlow id="MessageFlow_1" name="Направити на прибирання" sourceRef="SendTask_SendToCleaning" targetRef="StartEvent_ReceivedRoom" />
    <bpmn:messageFlow id="MessageFlow_2" name="Прибирання завершено" sourceRef="SendTask_ConfirmCleaning" targetRef="Event_ReceivedCleaningConfirm" />
    <bpmn:textAnnotation id="TextAnnotation_Parallel">
      <bpmn:text>Розрахунок додаткових послуг і прибирання номера виконуються паралельно</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Gateway_ParallelSplit" targetRef="TextAnnotation_Parallel" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hotel2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hotel2">
      <bpmn:lane id="Lane_Manager2" name="Менеджер">
        <bpmn:flowNodeRef>Task_CalcExtra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin2" name="Адміністратор">
        <bpmn:flowNodeRef>StartEvent_CheckinDay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ArrivalOrTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_GuestArrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_DayEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueKey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CheckoutDay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_SendToCleaning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceivedCleaningConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CheckedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkNoShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoShow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CheckinDay" name="Настав день заїзду">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:startEvent>
    <bpmn:task id="Task_FindBooking" name="Знайти бронювання гостя">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataStoreReference_BookingsReg1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gateway_ArrivalOrTimeout" name="Що станеться раніше — прибуття гостя чи кінець дня?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_GuestArrived" name="Гість прибув на рецепцію">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DayEnded" name="Минув день заїзду, гість не з&#39;явився">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CheckDocument" name="Перевірити документ гостя">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueKey" name="Видати ключ, встановити статус «заселено»">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_2">
        <bpmn:targetRef>DataObjectReference_Booking</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_CheckoutDay" name="Настав день виїзду">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CheckRoom" name="Перевірити стан номера при виїзді">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask_SendToCleaning" name="Направити номер на прибирання">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11c</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceivedCleaningConfirm" name="Отримано підтвердження прибирання">
      <bpmn:incoming>SequenceFlow_11c</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_ParallelSync">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CloseBooking" name="Закрити бронювання">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_4">
        <bpmn:targetRef>DataStoreReference_BookingsReg2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_CheckedOut" name="Виселено">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_MarkNoShow" name="Позначити бронювання статусом «не з&#39;явився»">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_NoShow" name="Гість не з&#39;явився">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_BookingsReg1" name="Реєстр бронювань" />
    <bpmn:dataStoreReference id="DataStoreReference_BookingsReg2" name="Реєстр бронювань" />
    <bpmn:dataObjectReference id="DataObjectReference_Booking" name="Бронювання" dataObjectRef="DataObject_Booking" />
    <bpmn:dataObject id="DataObject_Booking" />
    <bpmn:task id="Task_CalcExtra" name="Розрахувати додаткові послуги і сформувати підсумковий рахунок">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_3">
        <bpmn:targetRef>DataObjectReference_Bill</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_Bill" name="Підсумковий рахунок" dataObjectRef="DataObject_Bill" />
    <bpmn:dataObject id="DataObject_Bill" />
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_CheckinDay" targetRef="Task_FindBooking" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_FindBooking" targetRef="Gateway_ArrivalOrTimeout" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Gateway_ArrivalOrTimeout" targetRef="Event_GuestArrived" />
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Gateway_ArrivalOrTimeout" targetRef="Event_DayEnded" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Event_GuestArrived" targetRef="Task_CheckDocument" />
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Event_DayEnded" targetRef="Task_MarkNoShow" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_CheckDocument" targetRef="Task_IssueKey" />
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_IssueKey" targetRef="Event_CheckoutDay" />
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Event_CheckoutDay" targetRef="Task_CheckRoom" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_CheckRoom" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_ParallelSplit" targetRef="Task_CalcExtra" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_ParallelSplit" targetRef="SendTask_SendToCleaning" />
    <bpmn:sequenceFlow id="SequenceFlow_11c" sourceRef="SendTask_SendToCleaning" targetRef="Event_ReceivedCleaningConfirm" />
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Event_ReceivedCleaningConfirm" targetRef="Gateway_ParallelSync" />
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_CalcExtra" targetRef="Gateway_ParallelSync" />
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Gateway_ParallelSync" targetRef="Task_CloseBooking" />
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_CloseBooking" targetRef="EndEvent_CheckedOut" />
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_MarkNoShow" targetRef="EndEvent_NoShow" />
  </bpmn:process>
  <bpmn:process id="Process_Cleaning2" isExecutable="false">
    <bpmn:endEvent id="EndEvent_RoomReady" name="Номер готовий до нового заселення">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_ReceivedRoom" name="Отримано номер на прибирання">
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:startEvent>
    <bpmn:task id="Task_CleanRoom" name="Прибрати номер">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_ConfirmCleaning" name="Повідомити про завершення прибирання">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="SendTask_ConfirmCleaning" targetRef="EndEvent_RoomReady" />
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="StartEvent_ReceivedRoom" targetRef="Task_CleanRoom" />
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Task_CleanRoom" targetRef="SendTask_ConfirmCleaning" />
  </bpmn:process>
