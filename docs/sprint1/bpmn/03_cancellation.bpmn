<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Model3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_Model3">
    <bpmn:participant id="Participant_Guest3" name="Гість" processRef="Process_Guest3" />
    <bpmn:participant id="Participant_Hotel3" name="Готель" processRef="Process_Hotel3" />
    <bpmn:participant id="Participant_Provider" name="Платіжний провайдер" processRef="Process_Provider" />
    <bpmn:messageFlow id="MF1" name="Запит на скасування" sourceRef="G_SendCancelRequest" targetRef="H_StartCancelRequest" />
    <bpmn:messageFlow id="MF2" name="Сума до повернення" sourceRef="H_SendAmount" targetRef="G_CatchAmount" />
    <bpmn:messageFlow id="MF3" name="Підтвердження" sourceRef="G_SendConfirm" targetRef="H_CatchConfirm" />
    <bpmn:messageFlow id="MF4a" name="Без повернення" sourceRef="H_SendNoRefund" targetRef="G_CatchFinal" />
    <bpmn:messageFlow id="MF4b" name="Кошти повернуто" sourceRef="H_SendRefunded" targetRef="G_CatchFinal" />
    <bpmn:messageFlow id="MF5" name="Запит на повернення" sourceRef="H_SendRefundRequest" targetRef="P_Start" />
    <bpmn:messageFlow id="MF6" name="Повернення підтверджено" sourceRef="P_SendConfirm" targetRef="H_CatchProviderConfirm" />
    <bpmn:textAnnotation id="TextAnnotation_Penalty">
      <bpmn:text>Пороги штрафу — за політикою скасування, точні відсотки уточнюються у SRS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Penalty" sourceRef="H_GatewayDays" targetRef="TextAnnotation_Penalty" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Guest3" isExecutable="false">
    <bpmn:startEvent id="G_Start" name="Гість запросив скасування бронювання">
      <bpmn:outgoing>G_SF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="G_SendCancelRequest" name="Надіслати запит на скасування">
      <bpmn:incoming>G_SF1</bpmn:incoming>
      <bpmn:outgoing>G_SF2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="G_CatchFinal" name="Отримано підсумкове рішення щодо скасування">
      <bpmn:incoming>G_SF4</bpmn:incoming>
      <bpmn:outgoing>G_SF5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_G2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="G_End" name="Скасування оброблено">
      <bpmn:incoming>G_SF5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="G_CatchAmount" name="Отримано суму до повернення, запит на підтвердження">
      <bpmn:incoming>G_SF2</bpmn:incoming>
      <bpmn:outgoing>G_SF3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_G1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="G_SendConfirm" name="Підтвердити скасування">
      <bpmn:incoming>G_SF3</bpmn:incoming>
      <bpmn:outgoing>G_SF4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="G_SF1" sourceRef="G_Start" targetRef="G_SendCancelRequest" />
    <bpmn:sequenceFlow id="G_SF2" sourceRef="G_SendCancelRequest" targetRef="G_CatchAmount" />
    <bpmn:sequenceFlow id="G_SF4" sourceRef="G_SendConfirm" targetRef="G_CatchFinal" />
    <bpmn:sequenceFlow id="G_SF5" sourceRef="G_CatchFinal" targetRef="G_End" />
    <bpmn:sequenceFlow id="G_SF3" sourceRef="G_CatchAmount" targetRef="G_SendConfirm" />
  </bpmn:process>
  <bpmn:process id="Process_Hotel3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hotel3">
      <bpmn:lane id="Lane_Manager3" name="Менеджер">
        <bpmn:flowNodeRef>H_InitiateRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_CatchProviderConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_SendRefundRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_SendRefunded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_EndRefunded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System3" name="Система">
        <bpmn:flowNodeRef>H_StartCancelRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_EndNoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_SendNoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_GatewayRefundGt0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_EndChangedMind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_CancelCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_CatchTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_ReleaseRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_CatchConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_GatewayEventBased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_SendAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_GatewaySync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Penalty0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_PenaltyPart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_Penalty100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_GatewayDays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H_DetermineDays</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="H_StartCancelRequest" name="Отримано запит на скасування">
      <bpmn:outgoing>H_SF1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_H1" />
    </bpmn:startEvent>
    <bpmn:task id="H_InitiateRefund" name="Ініціювати повернення коштів через провайдера">
      <bpmn:incoming>H_SF13</bpmn:incoming>
      <bpmn:outgoing>H_SF15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="H_CatchProviderConfirm" name="Отримано підтвердження повернення від провайдера">
      <bpmn:incoming>H_SF16</bpmn:incoming>
      <bpmn:outgoing>H_SF17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_H3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="H_SendRefundRequest" name="Надіслати запит на повернення">
      <bpmn:incoming>H_SF15</bpmn:incoming>
      <bpmn:outgoing>H_SF16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="H_SendRefunded" name="Повідомити гостя про повернення коштів">
      <bpmn:incoming>H_SF17</bpmn:incoming>
      <bpmn:outgoing>H_SF18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="H_EndRefunded" name="Скасовано, кошти повернуто">
      <bpmn:incoming>H_SF18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="H_EndNoRefund" name="Скасовано без повернення">
      <bpmn:incoming>H_SF14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="H_SendNoRefund" name="Повідомити гостя про скасування без повернення">
      <bpmn:incoming>H_SF12</bpmn:incoming>
      <bpmn:outgoing>H_SF14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="H_GatewayRefundGt0" name="Сума повернення &#62; 0?">
      <bpmn:incoming>H_SF11</bpmn:incoming>
      <bpmn:outgoing>H_SF12</bpmn:outgoing>
      <bpmn:outgoing>H_SF13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="H_EndChangedMind" name="Гість передумав">
      <bpmn:incoming>H_SF10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="H_CancelCancellation" name="Скасувати заявку на скасування">
      <bpmn:incoming>H_SF9</bpmn:incoming>
      <bpmn:outgoing>H_SF10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="H_CatchTimeout" name="Минуло 10 хвилин без відповіді">
      <bpmn:incoming>H_SF7b</bpmn:incoming>
      <bpmn:outgoing>H_SF9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_H1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="DataStoreReference_Calendar" name="Календар бронювань" />
    <bpmn:task id="H_ReleaseRoom" name="Звільнити номер у календарі">
      <bpmn:incoming>H_SF8</bpmn:incoming>
      <bpmn:outgoing>H_SF11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_3">
        <bpmn:targetRef>DataStoreReference_Calendar</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="H_CatchConfirm" name="Отримано підтвердження скасування">
      <bpmn:incoming>H_SF7a</bpmn:incoming>
      <bpmn:outgoing>H_SF8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_H2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="H_GatewayEventBased" name="Що станеться раніше — підтвердження гостя чи таймаут?">
      <bpmn:incoming>H_SF6</bpmn:incoming>
      <bpmn:outgoing>H_SF7a</bpmn:outgoing>
      <bpmn:outgoing>H_SF7b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sendTask id="H_SendAmount" name="Показати суму до повернення і запросити підтвердження">
      <bpmn:incoming>H_SF5</bpmn:incoming>
      <bpmn:outgoing>H_SF6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="H_GatewaySync">
      <bpmn:incoming>H_SF4a</bpmn:incoming>
      <bpmn:incoming>H_SF4b</bpmn:incoming>
      <bpmn:incoming>H_SF4c</bpmn:incoming>
      <bpmn:outgoing>H_SF5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="H_Penalty0" name="Обчислити штраф 0 % — без штрафу">
      <bpmn:incoming>H_SF3a</bpmn:incoming>
      <bpmn:outgoing>H_SF4a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="H_PenaltyPart" name="Обчислити штраф за частковою ставкою">
      <bpmn:incoming>H_SF3b</bpmn:incoming>
      <bpmn:outgoing>H_SF4b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="H_Penalty100" name="Обчислити штраф 100 % — без повернення">
      <bpmn:incoming>H_SF3c</bpmn:incoming>
      <bpmn:outgoing>H_SF4c</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1fa6u9r">
        <bpmn:targetRef>DataObjectReference_Penalty</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_Penalty" name="Розрахунок штрафу" dataObjectRef="DataObject_Penalty" />
    <bpmn:dataObject id="DataObject_Penalty" />
    <bpmn:exclusiveGateway id="H_GatewayDays" name="Скільки днів залишилось до заїзду?">
      <bpmn:incoming>H_SF2</bpmn:incoming>
      <bpmn:outgoing>H_SF3a</bpmn:outgoing>
      <bpmn:outgoing>H_SF3b</bpmn:outgoing>
      <bpmn:outgoing>H_SF3c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="H_DetermineDays" name="Визначити кількість днів до дати заїзду">
      <bpmn:incoming>H_SF1</bpmn:incoming>
      <bpmn:outgoing>H_SF2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_1">
        <bpmn:targetRef>DataStoreReference_Bookings3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStoreReference_Bookings3" name="Реєстр бронювань" />
    <bpmn:sequenceFlow id="H_SF1" sourceRef="H_StartCancelRequest" targetRef="H_DetermineDays" />
    <bpmn:sequenceFlow id="H_SF13" name="так" sourceRef="H_GatewayRefundGt0" targetRef="H_InitiateRefund" />
    <bpmn:sequenceFlow id="H_SF15" sourceRef="H_InitiateRefund" targetRef="H_SendRefundRequest" />
    <bpmn:sequenceFlow id="H_SF16" sourceRef="H_SendRefundRequest" targetRef="H_CatchProviderConfirm" />
    <bpmn:sequenceFlow id="H_SF17" sourceRef="H_CatchProviderConfirm" targetRef="H_SendRefunded" />
    <bpmn:sequenceFlow id="H_SF18" sourceRef="H_SendRefunded" targetRef="H_EndRefunded" />
    <bpmn:sequenceFlow id="H_SF14" sourceRef="H_SendNoRefund" targetRef="H_EndNoRefund" />
    <bpmn:sequenceFlow id="H_SF12" name="ні" sourceRef="H_GatewayRefundGt0" targetRef="H_SendNoRefund" />
    <bpmn:sequenceFlow id="H_SF11" sourceRef="H_ReleaseRoom" targetRef="H_GatewayRefundGt0" />
    <bpmn:sequenceFlow id="H_SF10" sourceRef="H_CancelCancellation" targetRef="H_EndChangedMind" />
    <bpmn:sequenceFlow id="H_SF9" sourceRef="H_CatchTimeout" targetRef="H_CancelCancellation" />
    <bpmn:sequenceFlow id="H_SF7b" sourceRef="H_GatewayEventBased" targetRef="H_CatchTimeout" />
    <bpmn:sequenceFlow id="H_SF8" sourceRef="H_CatchConfirm" targetRef="H_ReleaseRoom" />
    <bpmn:sequenceFlow id="H_SF7a" sourceRef="H_GatewayEventBased" targetRef="H_CatchConfirm" />
    <bpmn:sequenceFlow id="H_SF6" sourceRef="H_SendAmount" targetRef="H_GatewayEventBased" />
    <bpmn:sequenceFlow id="H_SF5" sourceRef="H_GatewaySync" targetRef="H_SendAmount" />
    <bpmn:sequenceFlow id="H_SF4a" sourceRef="H_Penalty0" targetRef="H_GatewaySync" />
    <bpmn:sequenceFlow id="H_SF4b" sourceRef="H_PenaltyPart" targetRef="H_GatewaySync" />
    <bpmn:sequenceFlow id="H_SF4c" sourceRef="H_Penalty100" targetRef="H_GatewaySync" />
    <bpmn:sequenceFlow id="H_SF3a" name="≥7 днів" sourceRef="H_GatewayDays" targetRef="H_Penalty0" />
    <bpmn:sequenceFlow id="H_SF3b" name="3–6 днів" sourceRef="H_GatewayDays" targetRef="H_PenaltyPart" />
    <bpmn:sequenceFlow id="H_SF3c" name="&#60;3 днів" sourceRef="H_GatewayDays" targetRef="H_Penalty100" />
    <bpmn:sequenceFlow id="H_SF2" sourceRef="H_DetermineDays" targetRef="H_GatewayDays" />
  </bpmn:process>
  <bpmn:process id="Process_Provider" isExecutable="false">
    <bpmn:startEvent id="P_Start" name="Отримано запит на повернення">
      <bpmn:outgoing>P_SF1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_P1" />
    </bpmn:startEvent>
    <bpmn:task id="P_Process" name="Обробити повернення коштів">
